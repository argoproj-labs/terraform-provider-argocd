{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Terraform Provider",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "outputMode": "remote",
      "program": "${workspaceFolder}",
      "env": {},
      "args": [
        "-debug"
      ]
    },
    {
      "name": "Debug Selected Test",
      "request": "launch",
      "type": "go",
      "args": [
        "-test.v",
        "-test.run",
        "^${selectedText}$"
      ],
      "mode": "auto",
      "program": "${fileDirname}",
      "env": {
        "TF_ACC": "1",
        "TF_LOG": "info",
        "ARGOCD_VERSION": "v3.5.6",
        "K3S_VERSION": "v1.34.3-k3s3"
      },
      "showLog": true
    }
  ]
}
